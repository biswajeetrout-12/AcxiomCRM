@{
    ViewData["Title"] = "Account Locked — AcxiomCRM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, sans-serif;
            color: #f8fafc;
        }
        .lockout-card {
            background: #1e293b;
            border: 1px solid #dc2626;
            border-radius: 1rem;
            padding: 3rem;
            max-width: 480px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="lockout-card shadow-lg">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-lock-fill"></i>
        </div>
        <h3 class="fw-bold text-white mb-2">Account Temporarily Locked</h3>
        <p class="text-secondary mb-4">
            This account has been locked due to multiple consecutive failed login attempts in accordance with AcxiomCRM security policy. Please wait 15 minutes before attempting to sign in again or contact an administrator.
        </p>
        <a href="/Account/Login" class="btn btn-outline-light px-4 py-2">
            <i class="bi bi-box-arrow-in-left me-1"></i> Back to Login
        </a>
    </div>
</body>
</html>
