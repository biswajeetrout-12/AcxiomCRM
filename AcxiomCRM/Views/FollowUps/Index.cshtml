@model AcxiomCRM.ViewModels.FollowUps.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Follow-Up Tasks & Reminders</h4>
        <p class="text-muted small mb-0">Scheduled interactions across Customers, Leads, and Opportunities.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
        <i class="bi bi-calendar-plus-fill"></i> Schedule Follow-Up
    </a>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="typeFilter" class="form-select">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Demo" selected="@(Model.TypeFilter == "Demo")">Demo</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2 form-check form-switch ps-5">
                <input type="checkbox" name="upcomingOnly" value="true" class="form-check-input" id="checkUpcoming" @(Model.UpcomingOnly ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label small" for="checkUpcoming">Upcoming</label>
            </div>
            <div class="col-md-2 form-check form-switch ps-5">
                <input type="checkbox" name="overdueOnly" value="true" class="form-check-input" id="checkOverdue" @(Model.OverdueOnly ? "checked" : "") onchange="this.form.submit()" />
                <label class="form-check-label small text-danger" for="checkOverdue">Overdue</label>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-ups Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FollowUps.Any())
                {
                    @foreach (var f in Model.FollowUps)
                    {
                        var isOverdue = f.Status == "Planned" && f.FollowUpDate < DateTime.UtcNow;
                        <tr>
                            <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                            <td class="fw-semibold">
                                @f.Subject
                                @if (!string.IsNullOrEmpty(f.Remarks))
                                {
                                    <div class="text-muted small fw-normal">@f.Remarks</div>
                                }
                            </td>
                            <td>
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId" class="badge bg-light text-dark border text-decoration-none">
                                        <i class="bi bi-building me-1"></i> @f.Customer.CustomerName
                                    </a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId" class="badge bg-light text-dark border text-decoration-none">
                                        <i class="bi bi-funnel me-1"></i> @f.Lead.LeadName
                                    </a>
                                }
                                else if (f.Opportunity != null)
                                {
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId" class="badge bg-light text-dark border text-decoration-none">
                                        <i class="bi bi-briefcase me-1"></i> @f.Opportunity.OpportunityName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                    <i class="bi bi-clock me-1"></i> @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-secondary")">
                                    @f.Status
                                </span>
                            </td>
                            <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                            <td class="text-end">
                                @if (f.Status == "Planned")
                                {
                                    <div class="btn-group btn-group-sm">
                                        <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Mark Completed">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Cancel" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Cancel this follow-up?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Cancel">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-check fs-1 d-block mb-2 text-secondary"></i>
                            No follow-up records found matching your filters.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
