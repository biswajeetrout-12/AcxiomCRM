@model AcxiomCRM.ViewModels.Leads.LeadDetailsViewModel
@{
    ViewData["Title"] = Model.Lead.LeadName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0">@Model.Lead.LeadName</h4>
            <span class="badge bg-light text-dark border">@Model.Lead.LeadCode</span>
            <span class="badge status-@Model.Lead.Status.ToLower()">@Model.Lead.Status</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Lead Dossier & Activities</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Lead.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-success btn-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
        }
        else if (Model.Lead.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Lead.ConvertedCustomerId.Value" class="btn btn-outline-info btn-sm">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Lead
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-warning btn-sm text-dark">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Lead Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Company:</span>
                        <span class="fw-semibold">@(Model.Lead.CompanyName ?? "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email:</span>
                        <a href="mailto:@Model.Lead.Email" class="text-decoration-none">@Model.Lead.Email</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold">@Model.Lead.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Lead Source:</span>
                        <span class="badge bg-light text-dark border">@Model.Lead.Source</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Priority:</span>
                        <span class="badge @(Model.Lead.Priority == "Urgent" ? "bg-danger" : "bg-warning text-dark")">@Model.Lead.Priority</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Expected Contract Value:</span>
                        <span class="fw-bold text-success fs-6">$@Model.Lead.ExpectedValue.ToString("N0")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assigned Sales Executive:</span>
                        <span>@(Model.Lead.AssignedUser?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Captured Date:</span>
                        <span>@Model.Lead.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                    </li>
                </ul>

                @if (!string.IsNullOrEmpty(Model.Lead.Notes))
                {
                    <div class="mt-3">
                        <label class="fw-semibold small text-muted">Notes:</label>
                        <div class="bg-light p-2 rounded small">@Model.Lead.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Scheduled Follow-ups for Lead -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check text-warning me-2"></i>Scheduled Follow-Ups</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var f in Model.FollowUps)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-secondary">@f.FollowUpType</span>
                                    <span class="badge @(f.Status == "Completed" ? "bg-success" : "bg-primary")">@f.Status</span>
                                </div>
                                <div class="fw-semibold">@f.Subject</div>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-clock me-1"></i> @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                    @if (!string.IsNullOrEmpty(f.Remarks))
                                    {
                                        <div class="mt-1 bg-light p-2 rounded">@f.Remarks</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-2"></i>
                        <p class="mt-2 mb-0">No follow-ups recorded yet for this lead.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
