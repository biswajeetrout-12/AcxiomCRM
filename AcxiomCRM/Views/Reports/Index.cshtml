@model AcxiomCRM.ViewModels.Reports.MasterReportViewModel
@{
    ViewData["Title"] = "CRM Reports";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">CRM Analytics & Executive Reports</h4>
        <p class="text-muted small mb-0">Pipeline forecasting, lead conversion analytics, user productivity, and audit reporting.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" asp-route-ReportType="@Model.Filter.ReportType" asp-route-StartDate="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" asp-route-EndDate="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="btn btn-outline-success btn-sm shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print / PDF
        </button>
    </div>
</div>

<!-- Report Selection & Filters Strip -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <select name="ReportType" class="form-select fw-semibold" onchange="this.form.submit()">
                    <option value="Pipeline" selected="@(Model.Filter.ReportType == "Pipeline")">Opportunity Pipeline Report</option>
                    <option value="Conversion" selected="@(Model.Filter.ReportType == "Conversion")">Lead Conversion Report</option>
                    <option value="Activity" selected="@(Model.Filter.ReportType == "Activity")">User Productivity & Activity Report</option>
                    <option value="Customers" selected="@(Model.Filter.ReportType == "Customers")">Customer Portfolio Report</option>
                    <option value="FollowUps" selected="@(Model.Filter.ReportType == "FollowUps")">Follow-Up Compliance Report</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" name="StartDate" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" placeholder="Start Date" />
            </div>
            <div class="col-md-3">
                <input type="date" name="EndDate" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" placeholder="End Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Generate</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Active Report Content -->
@if (Model.Filter.ReportType == "Pipeline")
{
    <!-- Report 1: Pipeline Report -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Sales Pipeline Report (Stage & Owner-Wise)</h5>
            <span class="text-muted small">Weighted = Amount × Probability / 100</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Pipeline Stage</th>
                        <th>Account Owner</th>
                        <th class="text-center">Opportunity Count</th>
                        <th class="text-end">Face Amount</th>
                        <th class="text-end">Weighted Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PipelineItems.Any())
                    {
                        @foreach (var row in Model.PipelineItems)
                        {
                            <tr>
                                <td><span class="stage-badge stage-@row.Stage.ToLower()">@row.Stage</span></td>
                                <td class="fw-semibold">@row.OwnerName</td>
                                <td class="text-center"><span class="badge bg-light text-dark border">@row.OpportunityCount</span></td>
                                <td class="text-end fw-bold text-dark">$@row.TotalAmount.ToString("N0")</td>
                                <td class="text-end fw-bold text-primary">$@row.WeightedAmount.ToString("N0")</td>
                            </tr>
                        }
                        <tr class="table-light fw-bold">
                            <td colspan="2">Total Pipeline Summary</td>
                            <td class="text-center">@Model.PipelineItems.Sum(x => x.OpportunityCount)</td>
                            <td class="text-end text-dark">$@Model.PipelineItems.Sum(x => x.TotalAmount).ToString("N0")</td>
                            <td class="text-end text-primary">$@Model.PipelineItems.Sum(x => x.WeightedAmount).ToString("N0")</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No pipeline records in this timeframe.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.Filter.ReportType == "Conversion")
{
    <!-- Report 2: Conversion Report -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-funnel-fill text-success me-2"></i>Lead Source & Conversion Report</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Lead Source Channel</th>
                        <th class="text-center">Total Inbound Leads</th>
                        <th class="text-center">Converted to Customers</th>
                        <th class="text-center">Conversion Rate (%)</th>
                        <th class="text-end">Converted Revenue Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ConversionItems.Any())
                    {
                        @foreach (var c in Model.ConversionItems)
                        {
                            <tr>
                                <td class="fw-semibold"><span class="badge bg-light text-dark border">@c.Source</span></td>
                                <td class="text-center">@c.TotalLeads</td>
                                <td class="text-center"><span class="badge bg-success bg-opacity-10 text-success">@c.ConvertedLeads</span></td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <div class="progress" style="width: 60px; height: 6px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: @c.ConversionRate%"></div>
                                        </div>
                                        <span class="small fw-semibold">@c.ConversionRate.ToString("F1")%</span>
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-dark">$@c.ConvertedValue.ToString("N0")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No lead conversion data available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.Filter.ReportType == "Activity")
{
    <!-- Report 3: User Activity Report -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-person-workspace text-info me-2"></i>Sales Executive Productivity & Activity Counts</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Team Member</th>
                        <th class="text-center">Phone Calls</th>
                        <th class="text-center">Meetings</th>
                        <th class="text-center">Emails</th>
                        <th class="text-center">Tasks</th>
                        <th class="text-end">Total Touchpoints</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UserActivityItems.Any())
                    {
                        @foreach (var u in Model.UserActivityItems)
                        {
                            <tr>
                                <td class="fw-semibold">@u.UserName</td>
                                <td class="text-center"><span class="badge bg-light text-dark">@u.CallsCount</span></td>
                                <td class="text-center"><span class="badge bg-light text-dark">@u.MeetingsCount</span></td>
                                <td class="text-center"><span class="badge bg-light text-dark">@u.EmailsCount</span></td>
                                <td class="text-center"><span class="badge bg-light text-dark">@u.TasksCount</span></td>
                                <td class="text-end fw-bold text-primary">@u.TotalActivities</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No activity records in selected date range.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.Filter.ReportType == "Customers")
{
    <!-- Report 4: Customer Report -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill text-primary me-2"></i>Customer Portfolio Report</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Owner</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border">@c.CustomerCode</span></td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "—")</td>
                            <td>@(c.Owner?.FullName ?? "Unassigned")</td>
                            <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                            <td>@c.CreatedDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.Filter.ReportType == "FollowUps")
{
    <!-- Report 5: Follow-Up Compliance Report -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-check-fill text-warning me-2"></i>Follow-Up Compliance Report</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.FollowUps)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                            <td class="fw-semibold">@f.Subject</td>
                            <td>@f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td><span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-danger")">@f.Status</span></td>
                            <td>@(f.AssignedUser?.FullName ?? "Unassigned")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
