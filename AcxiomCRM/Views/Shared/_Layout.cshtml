<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AcxiomCRM — Role-Based Customer Relationship Management System" />
    <title>@ViewData["Title"] — AcxiomCRM</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom CRM Theme -->
    <link rel="stylesheet" href="~/css/crm-theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="crm-wrapper">
        @if (User.Identity?.IsAuthenticated == true)
        {
            @await Html.PartialAsync("_Sidebar")
        }

        <div class="crm-main">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="crm-navbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-sm d-md-none p-1" type="button" id="sidebarToggle" 
                                style="border: 1.5px solid #e5e7eb; background: #fff; border-radius: 8px; width: 34px; height: 34px;">
                            <i class="bi bi-list fs-5 text-secondary"></i>
                        </button>
                        <div>
                            <h6 class="mb-0 fw-700 text-dark" style="font-size: 0.95rem; font-weight: 700;">@ViewData["PageHeader"]</h6>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small d-none d-sm-flex align-items-center gap-1">
                            <i class="bi bi-clock"></i>
                            <span id="live-time">@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</span>
                        </span>
                        <div class="vr mx-1 d-none d-sm-block"></div>
                        <span class="badge d-flex align-items-center gap-1" 
                              style="background: rgba(37,99,235,0.1); color: #2563eb; padding: 0.45em 0.8em; font-weight: 600;">
                            <i class="bi bi-shield-check"></i>
                            @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "Sales Executive")
                        </span>
                    </div>
                </nav>
            }

            <main role="main" class="crm-content">
                @await Html.PartialAsync("_Notifications")
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="d-md-none" 
         style="display:none!important; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:1039; backdrop-filter:blur(2px);"
         onclick="closeSidebar()"></div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
