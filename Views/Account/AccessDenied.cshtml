@{
    ViewData["Title"] = "Access Denied — AcxiomCRM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: #0f172a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, sans-serif;
            color: #f8fafc;
        }
        .error-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 1rem;
            padding: 3rem;
            max-width: 480px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="error-card shadow-lg">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-shield-x"></i>
        </div>
        <h3 class="fw-bold text-white mb-2">Access Denied (403)</h3>
        <p class="text-secondary mb-4">
            You do not have permission to access this resource or administrative screen. Contact your administrator if you believe this is an error.
        </p>
        <a href="/Dashboard" class="btn btn-primary px-4 py-2">
            <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
        </a>
    </div>
</body>
</html>
