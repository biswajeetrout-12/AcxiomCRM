@model AcxiomCRM.ViewModels.Audit.AuditLogListViewModel
@{
    ViewData["Title"] = "Audit Log";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">System Audit Trail</h4>
        <p class="text-muted small mb-0">Immutable tracking of logins, logouts, access failures, security changes, and CRM data modifications.</p>
    </div>
    <span class="badge bg-secondary">Showing Latest 200 Entries</span>
</div>

<!-- Filter Strip -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="actionFilter" value="@Model.ActionFilter" class="form-control" placeholder="Filter by action (Login, Create...)" />
            </div>
            <div class="col-md-3">
                <select name="moduleFilter" class="form-select">
                    <option value="">All Entities / Modules</option>
                    <option value="Authentication" selected="@(Model.ModuleFilter == "Authentication")">Authentication</option>
                    <option value="Customer" selected="@(Model.ModuleFilter == "Customer")">Customer</option>
                    <option value="Lead" selected="@(Model.ModuleFilter == "Lead")">Lead</option>
                    <option value="Opportunity" selected="@(Model.ModuleFilter == "Opportunity")">Opportunity</option>
                    <option value="FollowUp" selected="@(Model.ModuleFilter == "FollowUp")">FollowUp</option>
                    <option value="Activity" selected="@(Model.ModuleFilter == "Activity")">Activity</option>
                    <option value="User" selected="@(Model.ModuleFilter == "User")">User</option>
                    <option value="Security" selected="@(Model.ModuleFilter == "Security")">Security</option>
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="fromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" placeholder="From Date" />
            </div>
            <div class="col-md-2">
                <input type="date" name="toDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" placeholder="To Date" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Log Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 font-monospace small">
            <thead class="font-sans-serif">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Entity / Module</th>
                    <th>Record ID</th>
                    <th>Result</th>
                    <th>IP Address</th>
                    <th>Details & Payload</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AuditLogs.Any())
                {
                    @foreach (var a in Model.AuditLogs)
                    {
                        <tr>
                            <td class="text-muted">@a.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@(a.User?.FullName ?? a.UserId ?? "System/Anonymous")</td>
                            <td>
                                <span class="badge @(a.Action.Contains("Failed") || a.Action.Contains("Lockout") ? "bg-danger" : a.Action.Contains("Success") || a.Action.Contains("Created") ? "bg-success" : "bg-primary")">
                                    @a.Action
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@a.EntityName</span></td>
                            <td>@(a.RecordId ?? "—")</td>
                            <td>
                                <span class="badge @(a.Result == "Success" ? "bg-success bg-opacity-10 text-success" : "bg-danger bg-opacity-10 text-danger")">
                                    @a.Result
                                </span>
                            </td>
                            <td class="text-muted">@(a.IpAddress ?? "—")</td>
                            <td>
                                <div>@(a.Details ?? "—")</div>
                                @if (!string.IsNullOrEmpty(a.NewValue))
                                {
                                    <small class="text-muted d-block mt-1">@a.NewValue</small>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                            No audit log entries matching your criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
