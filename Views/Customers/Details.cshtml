@model AcxiomCRM.ViewModels.Customers.CustomerDetailsViewModel
@{
    ViewData["Title"] = Model.Customer.CustomerName;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h4 class="fw-bold mb-0">@Model.Customer.CustomerName</h4>
            <span class="badge bg-light text-dark border">@Model.Customer.CustomerCode</span>
            <span class="badge @(Model.Customer.Status == "Active" ? "bg-success" : "bg-secondary")">@Model.Customer.Status</span>
        </div>
        <p class="text-muted small mb-0 mt-1">Customer Profile & Related CRM Activities</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Customer.CustomerId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-success btn-sm">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@Model.Customer.CustomerId" class="btn btn-warning btn-sm text-dark">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Customer Details Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Contact Information</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Company:</span>
                        <span class="fw-semibold">@(Model.Customer.CompanyName ?? "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Email:</span>
                        <a href="mailto:@Model.Customer.Email" class="text-decoration-none">@Model.Customer.Email</a>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold">@Model.Customer.Phone</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Location:</span>
                        <span>@($"{Model.Customer.City}, {Model.Customer.State}")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Address:</span>
                        <span>@(Model.Customer.Address ?? "—")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Assigned Owner:</span>
                        <span class="badge bg-light text-dark border">@(Model.Customer.Owner?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted">Created Date:</span>
                        <span>@Model.Customer.CreatedDate.ToString("dd MMM yyyy")</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Opportunities -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-briefcase text-success me-2"></i>Opportunities (@Model.Opportunities.Count)</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Amount</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Close Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Opportunities.Any())
                        {
                            @foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                            @opp.OpportunityName
                                        </a>
                                    </td>
                                    <td class="fw-bold">$@opp.Amount.ToString("N0")</td>
                                    <td><span class="stage-badge stage-@opp.Stage.ToLower()">@opp.Stage</span></td>
                                    <td>@opp.Probability%</td>
                                    <td>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @(opp.Status == "Won" ? "bg-success" : opp.Status == "Open" ? "bg-primary" : "bg-danger")">@opp.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No opportunities registered yet for this customer.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Follow-ups and Activities Row -->
<div class="row g-4">
    <!-- Scheduled Follow-Ups -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-check text-warning me-2"></i>Follow-Up Schedule</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var f in Model.FollowUps)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-secondary">@f.FollowUpType</span>
                                    <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-warning")">@f.Status</span>
                                </div>
                                <div class="fw-semibold">@f.Subject</div>
                                <div class="text-muted small mt-1">
                                    <i class="bi bi-clock me-1"></i> @f.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                    @if (!string.IsNullOrEmpty(f.Remarks))
                                    {
                                        <div class="mt-1 bg-light p-2 rounded small">@f.Remarks</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">No follow-ups scheduled.</div>
                }
            </div>
        </div>
    </div>

    <!-- Activity History Timeline -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history text-info me-2"></i>Interaction & Activity History</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.Activities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var a in Model.Activities)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-info bg-opacity-10 text-info">@a.ActivityType</span>
                                    <span class="text-muted small">@a.ActivityDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <div class="fw-semibold">@a.Subject</div>
                                @if (!string.IsNullOrEmpty(a.Description))
                                {
                                    <p class="text-muted small mb-0 mt-1">@a.Description</p>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">No activities logged yet.</div>
                }
            </div>
        </div>
    </div>
</div>
