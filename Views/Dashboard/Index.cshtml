@model AcxiomCRM.ViewModels.Dashboard.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Dashboard Filter & Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">CRM Performance & Pipeline Overview</h4>
        <p class="text-muted small mb-0">Live metrics according to your authorized role and assignments.</p>
    </div>
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-dateFilter="All" class="btn btn-sm @(Model.DateFilter == "All" ? "btn-primary" : "btn-outline-secondary")">All Time</a>
        <a asp-action="Index" asp-route-dateFilter="Today" class="btn btn-sm @(Model.DateFilter == "Today" ? "btn-primary" : "btn-outline-secondary")">Today</a>
        <a asp-action="Index" asp-route-dateFilter="ThisWeek" class="btn btn-sm @(Model.DateFilter == "ThisWeek" ? "btn-primary" : "btn-outline-secondary")">This Week</a>
        <a asp-action="Index" asp-route-dateFilter="ThisMonth" class="btn btn-sm @(Model.DateFilter == "ThisMonth" ? "btn-primary" : "btn-outline-secondary")">This Month</a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Customers -->
    <div class="col-xl-3 col-sm-6">
        <div class="card crm-stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Customers</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalCustomers</h3>
                    <span class="text-success small fw-medium"><i class="bi bi-shield-check"></i> Active Accounts</span>
                </div>
                <div class="crm-stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Total Leads & Open Leads -->
    <div class="col-xl-3 col-sm-6">
        <div class="card crm-stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Leads</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalLeads</h3>
                    <span class="text-info small fw-medium"><i class="bi bi-funnel"></i> @Model.OpenLeads Open / Active</span>
                </div>
                <div class="crm-stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-funnel"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Pipeline Value -->
    <div class="col-xl-3 col-sm-6">
        <div class="card crm-stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Open Pipeline Value</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">$@Model.TotalPipelineValue.ToString("N0")</h3>
                    <span class="text-secondary small fw-medium">Weighted: $@Model.WeightedPipelineValue.ToString("N0")</span>
                </div>
                <div class="crm-stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-currency-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Follow-Ups -->
    <div class="col-xl-3 col-sm-6">
        <div class="card crm-stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pending Follow-Ups</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">@Model.PendingFollowUpsCount</h3>
                    @if (Model.OverdueFollowUpsCount > 0)
                    {
                        <span class="text-danger small fw-semibold"><i class="bi bi-exclamation-circle-fill"></i> @Model.OverdueFollowUpsCount Overdue</span>
                    }
                    else
                    {
                        <span class="text-success small fw-medium"><i class="bi bi-check-circle"></i> On Schedule</span>
                    }
                </div>
                <div class="crm-stat-icon @(Model.OverdueFollowUpsCount > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-warning bg-opacity-10 text-warning")">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Opportunity Breakdown Pill Highlights -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 bg-light p-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-semibold">Open Opportunities</span>
                <span class="badge bg-primary fs-6">@Model.OpenOpportunities</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-light p-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-semibold">Won Opportunities</span>
                <span class="badge bg-success fs-6">@Model.WonOpportunities</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 bg-light p-3">
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small fw-semibold">Lost Opportunities</span>
                <span class="badge bg-danger fs-6">@Model.LostOpportunities</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- Chart 1: Pipeline Stage Value -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-bar-chart-fill text-primary me-2"></i>Sales Opportunity Pipeline ($)</h6>
                <span class="text-muted small">By Stage</span>
            </div>
            <div class="card-body">
                <canvas id="pipelineChart" height="240"></canvas>
            </div>
        </div>
    </div>

    <!-- Chart 2: Lead Status Distribution -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pie-chart-fill text-info me-2"></i>Lead Status Breakdown</h6>
                <span class="text-muted small">Distribution</span>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="max-height: 240px; width: 100%;">
                    <canvas id="leadStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Monthly Sales & Activity Row -->
<div class="row g-4 mb-4">
    <!-- Chart 3: Monthly Won Revenue -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-graph-up text-success me-2"></i>Closed Won Sales Revenue Trend</h6>
                <span class="text-muted small">Past 6 Months</span>
            </div>
            <div class="card-body">
                <canvas id="monthlySalesChart" height="200"></canvas>
            </div>
        </div>
    </div>

    <!-- Upcoming Follow-Ups Widget -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-alarm-fill text-warning me-2"></i>Upcoming & Scheduled Follow-Ups</h6>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-primary py-0">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingFollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.UpcomingFollowUps)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                                <div>
                                    <div class="fw-semibold text-dark mb-1">
                                        <span class="badge bg-secondary me-1">@item.FollowUpType</span>
                                        @item.Subject
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-calendar me-1"></i> @item.FollowUpDate.ToString("dd MMM yyyy, hh:mm tt")
                                        @if (item.Customer != null)
                                        {
                                            <span class="ms-2"><i class="bi bi-building me-1"></i> @item.Customer.CustomerName</span>
                                        }
                                        else if (item.Lead != null)
                                        {
                                            <span class="ms-2"><i class="bi bi-person me-1"></i> @item.Lead.LeadName</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <form asp-controller="FollowUps" asp-action="Complete" asp-route-id="@item.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Completed">
                                            <i class="bi bi-check2"></i> Complete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check2-circle fs-2 text-success"></i>
                        <p class="mt-2 mb-0">No pending follow-ups right now.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Top Deals & Recent Activity -->
<div class="row g-4">
    <!-- Top Active Deals -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-star-fill text-warning me-2"></i>High-Value Open Opportunities</h6>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-sm btn-outline-primary py-0">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Stage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model.HighValueOpportunities)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-semibold text-decoration-none">
                                        @opp.OpportunityName
                                    </a>
                                </td>
                                <td>@(opp.Customer?.CustomerName ?? "—")</td>
                                <td class="fw-bold text-dark">$@opp.Amount.ToString("N0")</td>
                                <td>
                                    <span class="stage-badge stage-@opp.Stage.ToLower()">@opp.Stage</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Activities Feed -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clock-history text-secondary me-2"></i>Recent Activity Feed</h6>
                <a asp-controller="Activities" asp-action="Index" class="btn btn-sm btn-outline-primary py-0">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentActivities.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var act in Model.RecentActivities)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@act.ActivityType</span>
                                    <small class="text-muted">@act.ActivityDate.ToString("dd MMM, hh:mm tt")</small>
                                </div>
                                <div class="fw-semibold text-dark">@act.Subject</div>
                                @if (!string.IsNullOrEmpty(act.Description))
                                {
                                    <p class="text-muted small mb-1">@act.Description</p>
                                }
                                <div class="text-muted small">
                                    <i class="bi bi-person me-1"></i> @(act.AssignedUser?.FullName ?? "User")
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="mt-2 mb-0">No activities recorded yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Data from backend
            const pipelineLabels = @Html.Raw(JsonSerializer.Serialize(Model.PipelineStageLabels));
            const pipelineAmounts = @Html.Raw(JsonSerializer.Serialize(Model.PipelineStageAmounts));
            const leadStatusLabels = @Html.Raw(JsonSerializer.Serialize(Model.LeadStatusLabels));
            const leadStatusCounts = @Html.Raw(JsonSerializer.Serialize(Model.LeadStatusCounts));
            const monthlySalesLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySalesLabels));
            const monthlySalesAmounts = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySalesAmounts));

            // Chart 1: Pipeline Stage Bar Chart
            const pipelineCtx = document.getElementById('pipelineChart').getContext('2d');
            new Chart(pipelineCtx, {
                type: 'bar',
                data: {
                    labels: pipelineLabels,
                    datasets: [{
                        label: 'Pipeline Value ($)',
                        data: pipelineAmounts,
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.75)',
                            'rgba(245, 158, 11, 0.75)',
                            'rgba(139, 92, 246, 0.75)',
                            'rgba(16, 185, 129, 0.75)',
                            'rgba(239, 68, 68, 0.75)'
                        ],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '$' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });

            // Chart 2: Lead Status Doughnut Chart
            const leadCtx = document.getElementById('leadStatusChart').getContext('2d');
            new Chart(leadCtx, {
                type: 'doughnut',
                data: {
                    labels: leadStatusLabels,
                    datasets: [{
                        data: leadStatusCounts,
                        backgroundColor: [
                            '#38bdf8',
                            '#facc15',
                            '#4ade80',
                            '#2563eb',
                            '#f87171'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Chart 3: Monthly Sales Revenue Line Chart
            const salesCtx = document.getElementById('monthlySalesChart').getContext('2d');
            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: monthlySalesLabels,
                    datasets: [{
                        label: 'Closed Won Revenue ($)',
                        data: monthlySalesAmounts,
                        borderColor: '#10b981',
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '$' + value.toLocaleString(); }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
