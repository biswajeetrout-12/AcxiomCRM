@model AcxiomCRM.ViewModels.FollowUps.FollowUpCreateEditViewModel
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-plus text-primary me-2"></i>Schedule CRM Follow-Up</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="followUpForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FollowUpType" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="FollowUpType" class="form-select">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">In-Person Meeting</option>
                                <option value="Email">Email Communication</option>
                                <option value="Demo">Product Demonstration</option>
                                <option value="Task">General Task</option>
                            </select>
                            <span asp-validation-for="FollowUpType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="FollowUpDate" class="form-control" type="datetime-local" min="@DateTime.Today.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="FollowUpDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discuss revised proposal & quote adjustments" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomersList">
                                <option value="">-- Customer (Optional) --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.LeadsList">
                                <option value="">-- Lead (Optional) --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="OpportunityId" class="form-label fw-semibold"></label>
                            <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.OpportunitiesList">
                                <option value="">-- Opportunity (Optional) --</option>
                            </select>
                        </div>
                    </div>

                    @if (!User.IsInRole("SalesExecutive"))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.UsersList">
                                <option value="">-- Assign User --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Remarks" class="form-label fw-semibold"></label>
                        <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Context notes or agenda..."></textarea>
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-calendar-check me-1"></i>Save Follow-Up</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
